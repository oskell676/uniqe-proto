ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: send real verification emails via SMTP when someone signs up
# with an email address. If SMTP_HOST is left unset, the server prints the
# verification code to its own terminal instead, so you can still test the
# flow locally without setting up an email account.
#
# Example for Gmail: create an "app password" at myaccount.google.com/apppasswords
# (regular Gmail passwords won't work here), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-address@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM=your-address@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
